// Reference Firestore Security Rule Helpers (Peerbots Standard)
// Copy into each Firebase repo's firestore.rules as needed.

function isAuthenticated() {
  return request.auth != null;
}

function isNotAnonymous() {
  return isAuthenticated() &&
    request.auth.token.firebase.sign_in_provider != 'anonymous';
}

function isEmailVerified() {
  return isNotAnonymous() && request.auth.token.email_verified == true;
}

function isAdmin() {
  return isAuthenticated() && request.auth.token.admin == true;
}

// Instant ban check (closes the 1-hour Firebase ID token refresh window)
function isNotBanned() {
  return isAuthenticated() &&
    request.auth.token.banned != true &&
    !exists(/databases/$(database)/documents/bannedUsers/$(request.auth.uid));
}

// Soft mute check (allows private app use, blocks public Marketplace/review publishing)
function isNotMuted() {
  return isNotBanned() &&
    request.auth.token.muted != true &&
    !exists(/databases/$(database)/documents/mutedUsers/$(request.auth.uid));
}

// Prevent users from re-publishing content locked by a moderator
function canPublishContent(existingData, nextData) {
  return !(existingData.moderationLocked == true && nextData.public == true);
}
